# Protect sensitive files & Database
<FilesMatch "\.(sqlite|db|sq3|sqlite3|env|log|git|ini|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory indexing (Listing files)
Options -Indexes
